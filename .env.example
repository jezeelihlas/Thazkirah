# Register a Google OAuth client of type "Web application".
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
APP_URL=http://localhost:3000

# Server-only Supabase secret key. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
# Supabase publishable (or legacy anon) key for email/password Auth, not the secret key.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Run node scripts/setup-admin.mjs your-email@example.com
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
