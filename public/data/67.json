b95\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0b9f\u0bc8\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd. \u0bb0\u0bb9\u0bcd\u0bae\u0bbe\u0ba9\u0bbf\u0ba9\u0bcd \u0baa\u0b9f\u0bc8\u0baa\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u0b8e\u0bb5\u0bcd\u0bb5\u0bbf\u0ba4 \u0b8f\u0bb1\u0bcd\u0bb1\u0ba4\u0bcd \u0ba4\u0bbe\u0bb4\u0bcd\u0bb5\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0ba4\u0bbf\u0bb2\u0bcd\u0bb2\u0bc8. \u0b86\u0b95, \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0baf\u0bc8 \u0ba8\u0bc0\u0bb0\u0bcd \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bb5\u0bc0\u0bb0\u0bbe\u0b95! \u0b8f\u0ba4\u0bbe\u0bb5\u0ba4\u0bc1 \u0baa\u0bbf\u0bb3\u0bb5\u0bc1\u0b95\u0bb3\u0bc8 (\u0bb5\u0bbf\u0bb0\u0bbf\u0b9a\u0bb2\u0bcd\u0b95\u0bb3\u0bc8) \u0ba8\u0bc0\u0bb0\u0bcd (\u0bb5\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd) \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bc0\u0bb0\u0bbe?","footnotes":""},{"id":"5245","sura":"67","aya":"4","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0671\u0631\u06e1\u062c\u0650\u0639\u0650 \u0671\u0644\u06e1\u0628\u064e\u0635\u064e\u0631\u064e \u0643\u064e\u0631\u0651\u064e\u062a\u064e\u064a\u06e1\u0646\u0650 \u064a\u064e\u0646\u0642\u064e\u0644\u0650\u0628\u06e1 \u0625\u0650\u0644\u064e\u064a\u06e1\u0643\u064e \u0671\u0644\u06e1\u0628\u064e\u0635\u064e\u0631\u064f \u062e\u064e\u0627\u0633\u0650\u0626\u0657\u0627 \u0648\u064e\u0647\u064f\u0648\u064e \u062d\u064e\u0633\u0650\u064a\u0631\u065e","translation":"\u0baa\u0bbf\u0bb1\u0b95\u0bc1, \u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0baf\u0bc8 \u0b87\u0bb0\u0bc1 \u0bae\u0bc1\u0bb1\u0bc8 \u0ba4\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bb5\u0bc0\u0bb0\u0bbe\u0b95! \u0b85\u0ba8\u0bcd\u0ba4\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8 \u0b87\u0bb4\u0bbf\u0bb5\u0b9f\u0bc8\u0ba8\u0bcd\u0ba4\u0ba4\u0bbe\u0b95 \u0b89\u0bae\u0bcd \u0baa\u0b95\u0bcd\u0b95\u0bae\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0bbf\u0bb5\u0bbf\u0b9f\u0bc1\u0bae\u0bcd. \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd, \u0b85\u0ba4\u0bc1 \u0b95\u0bb3\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bbf\u0b9f\u0bc1\u0bae\u0bcd.","footnotes":""},{"id":"5246","sura":"67","aya":"5","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0632\u064e\u064a\u0651\u064e\u0646\u0651\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u062f\u0651\u064f\u0646\u06e1\u064a\u064e\u0627 \u0628\u0650\u0645\u064e\u0635\u064e\u0670\u0628\u0650\u064a\u062d\u064e \u0648\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064e\u0627 \u0631\u064f\u062c\u064f\u0648\u0645\u0657\u0627 \u0644\u0651\u0650\u0644\u0634\u0651\u064e\u064a\u064e\u0670\u0637\u0650\u064a\u0646\u0650\u06d6 \u0648\u064e\u0623\u064e\u0639\u06e1\u062a\u064e\u062f\u06e1\u0646\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u064e \u0671\u0644\u0633\u0651\u064e\u0639\u0650\u064a\u0631\u0650","translation":"\u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bbe\u0b95 \u0b95\u0bc0\u0bb4\u0bcd \u0bb5\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bc8 (\u0ba8\u0b9f\u0bcd\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd \u0b8e\u0ba9\u0bc1\u0bae\u0bcd) \u0bb5\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0ba8\u0bbe\u0bae\u0bcd \u0b85\u0bb2\u0b99\u0bcd\u0b95\u0bb0\u0bbf\u0ba4\u0bcd\u0ba4\u0bcb\u0bae\u0bcd. \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd, (\u0bb5\u0bbe\u0ba9\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0baa\u0bc7\u0b9a\u0bcd\u0b9a\u0bc8 \u0b92\u0b9f\u0bcd\u0b9f\u0bc1\u0b95\u0bcd \u0b95\u0bc7\u0b9f\u0bcd\u0b95\u0bbf\u0bb1) \u0bb7\u0bc8\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd\u0b95\u0bb3\u0bc8 \u0b8e\u0bb1\u0bbf\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0b95 \u0b85\u0bb5\u0bb1\u0bcd\u0bb1\u0bc8 (-\u0ba8\u0b9f\u0bcd\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bc8) \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcb\u0bae\u0bcd. \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd, \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b95\u0bca\u0bb4\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bc6\u0bb0\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0ba8\u0bb0\u0b95 \u0ba8\u0bc6\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bcd \u0ba4\u0ba3\u0bcd\u0b9f\u0ba9\u0bc8\u0baf\u0bc8 \u0ba4\u0baf\u0bbe\u0bb0\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3\u0bcb\u0bae\u0bcd.","footnotes":""},{"id":"5247","sura":"67","aya":"6","arabic_text":"\u0648\u064e\u0644\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0628\u0650\u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u064f \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e\u06d6 \u0648\u064e\u0628\u0650\u0626\u06e1\u0633\u064e \u0671\u0644\u06e1\u0645\u064e\u0635\u0650\u064a\u0631\u064f","translation":"\u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb1\u0bc8\u0bb5\u0ba9\u0bc8 \u0ba8\u0bbf\u0bb0\u0bbe\u0b95\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bb0\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0ba4\u0ba3\u0bcd\u0b9f\u0ba9\u0bc8 \u0b89\u0ba3\u0bcd\u0b9f\u0bc1. \u0b85\u0ba4\u0bc1 \u0bae\u0bc0\u0bb3\u0bc1\u0bae\u0bbf\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0bae\u0bbf\u0b95\u0b95\u0bcd \u0b95\u0bc6\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.","footnotes":""},{"id":"5248","sura":"67","aya":"7","arabic_text":"\u0625\u0650\u0630\u064e\u0627\u0653 \u0623\u064f\u0644\u06e1\u0642\u064f\u0648\u0627\u0652 \u0641\u0650\u064a\u0647\u064e\u0627 \u0633\u064e\u0645\u0650\u0639\u064f\u0648\u0627\u0652 \u0644\u064e\u0647\u064e\u0627 \u0634\u064e\u0647\u0650\u064a\u0642\u0657\u0627 \u0648\u064e\u0647\u0650\u064a\u064e \u062a\u064e\u0641\u064f\u0648\u0631\u064f","translation":"\u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b85(\u0ba8\u0bcd\u0ba4 \u0ba8\u0bb0\u0b95\u0ba4\u0bcd)\u0ba4\u0bbf\u0bb2\u0bcd \u0b8e\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0bbe\u0bb2\u0bcd, - \u0b85\u0ba4\u0bc1\u0bb5\u0bc1\u0bae\u0bcb \u0b95\u0bca\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95 - \u0b85\u0ba4\u0bbf\u0bb2\u0bcd (\u0b92\u0bb0\u0bc1) \u0b95\u0b9f\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0b9a\u0ba4\u0bcd\u0ba4\u0ba4\u0bcd\u0ba4\u0bc8 \u0b9a\u0bc6\u0bb5\u0bbf\u0baf\u0bc1\u0bb1\u0bc1\u0bb5\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd.","footnotes":""},{"id":"5249","sura":"67","aya":"8","arabic_text":"\u062a\u064e\u0643\u064e\u0627\u062f\u064f \u062a\u064e\u0645\u064e\u064a\u0651\u064e\u0632\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0638\u0650\u06d6 \u0643\u064f\u0644\u0651\u064e\u0645\u064e\u0627\u0653 \u0623\u064f\u0644\u06e1\u0642\u0650\u064a\u064e \u0641\u0650\u064a\u0647\u064e\u0627 \u0641\u064e\u0648\u06e1\u062c\u065e \u0633\u064e\u0623\u064e\u0644\u064e\u0647\u064f\u0645\u06e1 \u062e\u064e\u0632\u064e\u0646\u064e\u062a\u064f\u0647\u064e\u0627\u0653 \u0623\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u0623\u06e1\u062a\u0650\u0643\u064f\u0645\u06e1 \u0646\u064e\u0630\u0650\u064a\u0631\u065e","translation":"\u0b85(\u0ba8\u0bcd\u0ba4 \u0ba8\u0bb0\u0b95\u0bae\u0bbe\u0ba9)\u0ba4\u0bc1 (\u0ba8\u0bbf\u0bb0\u0bbe\u0b95\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc0\u0ba4\u0bc1\u0bb3\u0bcd\u0bb3) \u0b95\u0bcb\u0baa\u0ba4\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd (\u0ba4\u0ba9\u0bbf\u0ba4\u0bcd \u0ba4\u0ba9\u0bbf\u0baf\u0bbe\u0b95 \u0baa\u0bbf\u0bb0\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1) \u0ba4\u0bc6\u0bb0\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bbf\u0b9f \u0ba8\u0bc6\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbf\u0bb5\u0bbf\u0b9f\u0bc1\u0bae\u0bcd. \u0b85\u0ba4\u0bbf\u0bb2\u0bcd (\u0baa\u0bbe\u0bb5\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd) \u0b92\u0bb0\u0bc1 \u0b95\u0bc2\u0b9f\u0bcd\u0b9f\u0bae\u0bcd \u0b8e\u0bb1\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0baa\u0bcb\u0ba4\u0bc6\u0bb2\u0bcd\u0bb2\u0bbe\u0bae\u0bcd, \u201c\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0b9f\u0bae\u0bcd \u0b93\u0bb0\u0bcd \u0b8e\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bcd \u0bb5\u0bb0\u0bb5\u0bbf\u0bb2\u0bcd\u0bb2\u0bc8\u0baf\u0bbe?\u201d \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b85\u0ba4\u0ba9\u0bcd \u0b95\u0bbe\u0bb5\u0bb2\u0bbe\u0bb3\u0bbf\u0b95\u0bb3\u0bcd \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0b9f\u0bae\u0bcd \u0b95\u0bc7\u0b9f\u0bcd\u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd.","footnotes":""},{"id":"5250","sura":"67","aya":"9","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0628\u064e\u0644\u064e\u0649\u0670 \u0642\u064e\u062f\u06e1 \u062c\u064e\u0627\u0653\u0621\u064e\u0646\u064e\u0627 \u0646\u064e\u0630\u0650\u064a\u0631\u065e \u0641\u064e\u0643\u064e\u0630\u0651\u064e\u0628\u06e1\u0646\u064e\u0627 \u0648\u064e\u0642\u064f\u0644\u06e1\u0646\u064e\u0627 \u0645\u064e\u0627 \u0646\u064e\u0632\u0651\u064e\u0644\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u0650\u0646 \u0634\u064e\u064a\u06e1\u0621\u064d \u0625\u0650\u0646\u06e1 \u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u0650\u064a \u0636\u064e\u0644\u064e\u0670\u0644\u0656 \u0643\u064e\u0628\u0650\u064a\u0631\u0656","translation":"\u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc2\u0bb1\u0bc1\u0bb5\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd: \u201c\u0b8f\u0ba9\u0bcd \u0bb5\u0bb0\u0bb5\u0bbf\u0bb2\u0bcd\u0bb2\u0bc8, \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bbe\u0b95 \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0b9f\u0bae\u0bcd \u0b8e\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bcd \u0bb5\u0ba8\u0bcd\u0ba4\u0bbe\u0bb0\u0bcd. \u0b86\u0ba9\u0bbe\u0bb2\u0bcd, \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd (\u0b85\u0bb5\u0bb0\u0bc8) \u0baa\u0bca\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0ba4\u0bcd\u0ba4\u0bcb\u0bae\u0bcd. \u0b85\u0bb2\u0bcd\u0bb2\u0bbe\u0bb9\u0bcd \u0b8e\u0ba4\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b87\u0bb1\u0b95\u0bcd\u0b95\u0bb5\u0bbf\u0bb2\u0bcd\u0bb2\u0bc8. (\u0ba4\u0bc2\u0ba4\u0bb0\u0bcd\u0b95\u0bb3\u0bc7!) \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bc6\u0bb0\u0bbf\u0baf \u0bb5\u0bb4\u0bbf\u0b95\u0bc7\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bc7\u0baf\u0bc7 \u0ba4\u0bb5\u0bbf\u0bb0 (\u0ba8\u0bc7\u0bb0\u0bcd\u0bb5\u0bb4\u0bbf\u0baf\u0bbf\u0bb2\u0bcd) \u0b87\u0bb2\u0bcd\u0bb2\u0bc8 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc2\u0bb1\u0bbf\u0ba9\u0bcb\u0bae\u0bcd.\u201d","footnotes":""},{"id":"5251","sura":"67","aya":"10","arabic_text":"\u0648\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0644\u064e\u0648\u06e1 \u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064e\u0633\u06e1\u0645\u064e\u0639\u064f \u0623\u064e\u0648\u06e1 \u0646\u064e\u0639\u06e1\u0642\u0650\u0644\u064f \u0645\u064e\u0627 \u0643\u064f\u0646\u0651\u064e\u0627 \u0641\u0650\u064a\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u0633\u0651\u064e\u0639\u0650\u064a\u0631\u0650","translation":"\u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd, \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc2\u0bb1\u0bc1\u0bb5\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd: \u201c\u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bc6\u0bb5\u0bbf \u0b8f\u0bb1\u0bcd\u0baa\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbe\u0b95; \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1, \u0b9a\u0bbf\u0ba8\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0baa\u0bc1\u0bb0\u0bbf\u0baa\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd (\u0b87\u0ba9\u0bcd\u0bb1\u0bc1) \u0ba8\u0bb0\u0b95\u0bb5\u0bbe\u0b9a\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b86\u0b95\u0bbf \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95 \u0bae\u0bbe\u0b9f\u0bcd\u0b9f\u0bcb\u0bae\u0bcd.\u201d","footnotes":""},{"id":"5252","sura":"67","aya":"11","arabic_text":"\u0641\u064e\u0671\u0639\u06e1\u062a\u064e\u0631\u064e\u0641\u064f\u0648\u0627\u0652 \u0628\u0650\u0630\u064e\u0646\u06e2\u0628\u0650\u0647\u0650\u0645\u06e1 \u0641\u064e\u0633\u064f\u062d\u06e1\u0642\u0657\u0627 \u0644\u0651\u0650\u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u0633\u0651\u064e\u0639\u0650\u064a\u0631\u0650","translation":"\u0b86\u0b95, \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc1\u0bb1\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bc8 \u0b92\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bcd \u0b95\u0bca\u0bb3\u0bcd\u0bb5\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd. \u0b86\u0b95\u0bb5\u0bc7, \u0ba8\u0bb0\u0b95\u0bb5\u0bbe\u0b9a\u0bbf\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bc7\u0b9f\u0bc1\u0ba4\u0bbe\u0ba9\u0bcd!","footnotes":""},{"id":"5253","sura":"67","aya":"12","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u062e\u06e1\u0634\u064e\u0648\u06e1\u0646\u064e \u0631\u064e\u0628\u0651\u064e\u0647\u064f\u0645 \u0628\u0650\u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0644\u064e\u0647\u064f\u0645 \u0645\u0651\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u065e \u0648\u064e\u0623\u064e\u062c\u06e1\u0631\u065e \u0643\u064e\u0628\u0650\u064a\u0631\u065e","translation":"\u0ba8\u0bbf\u0b9a\u0bcd\u0b9a\u0baf\u0bae\u0bbe\u0b95 \u0b8e\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bc8\u0bb5\u0bbf\u0bb2\u0bcd \u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb1\u0bc8\u0bb5\u0ba9\u0bc8 \u0baa\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bb5\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcb \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0ba9\u0bcd\u0ba9\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0bae\u0bcd \u0baa\u0bc6\u0bb0\u0bbf\u0baf \u0b95\u0bc2\u0bb2\u0bbf\u0baf\u0bc1\u0bae\u0bcd \u0b89\u0ba3\u0bcd\u0b9f\u0bc1.","footnotes":""},{"id":"5254","sura":"67","aya":"13","arabic_text":"\u0648\u064e\u0623\u064e\u0633\u0650\u0631\u0651\u064f\u0648\u0627\u0652 \u0642\u064e\u0648\u06e1\u0644\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u0648\u0650 \u0671\u062c\u06e1\u0647\u064e\u0631\u064f\u0648\u0627\u0652 \u0628\u0650\u0647\u0650\u06e6\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0639\u064e\u0644\u0650\u064a\u0645\u064f\u06e2 \u0628\u0650\u0630\u064e\u0627\u062a\u0650 \u0671\u0644\u0635\u0651\u064f\u062f\u064f\u0648\u0631\u0650","translation":"\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bc7\u0b9a\u0bcd\u0b9a\u0bc8 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb0\u0b95\u0b9a\u0bbf\u0baf\u0bae\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0bc7\u0b9a\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd! \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1, \u0b85\u0ba4\u0bc8 \u0b89\u0bb0\u0b95\u0bcd\u0b95\u0baa\u0bcd \u0baa\u0bc7\u0b9a\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd! \u0ba8\u0bbf\u0b9a\u0bcd\u0b9a\u0baf\u0bae\u0bbe\u0b95 \u0b85\u0bb5\u0ba9\u0bcd (\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd) \u0ba8\u0bc6\u0b9e\u0bcd\u0b9a\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc8 \u0ba8\u0ba9\u0bcd\u0b95\u0bb1\u0bbf\u0ba8\u0bcd\u0ba4\u0bb5\u0ba9\u0bcd \u0b86\u0bb5\u0bbe\u0ba9\u0bcd.","footnotes":""},{"id":"5255","sura":"67","aya":"14","arabic_text":"\u0623\u064e\u0644\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0645\u064e\u0646\u06e1 \u062e\u064e\u0644\u064e\u0642\u064e \u0648\u064e\u0647\u064f\u0648\u064e \u0671\u0644\u0644\u0651\u064e\u0637\u0650\u064a\u0641\u064f \u0671\u0644\u06e1\u062e\u064e\u0628\u0650\u064a\u0631\u064f","translation":"\u0b8e\u0bb5\u0ba9\u0bcd \u0baa\u0b9f\u0bc8\u0ba4\u0bcd\u0ba4\u0bbe\u0ba9\u0bcb \u0b85\u0bb5\u0ba9\u0bcd \u0b85\u0bb1\u0bbf\u0baf\u0bae\u0bbe\u0b9f\u0bcd\u0b9f\u0bbe\u0ba9\u0bbe? \u0b85\u0bb5\u0ba9\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd \u0bae\u0bbf\u0b95 \u0ba8\u0bc1\u0b9f\u0bcd\u0baa\u0bae\u0bbe\u0ba9\u0bb5\u0ba9\u0bcd, \u0b86\u0bb4\u0bcd\u0ba8\u0bcd\u0ba4\u0bb1\u0bbf\u0baa\u0bb5\u0ba9\u0bcd \u0b86\u0bb5\u0bbe\u0ba9\u0bcd.","footnotes":""},{"id":"5256","sura":"67","aya":"15","arabic_text":"\u0647\u064f\u0648\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062c\u064e\u0639\u064e\u0644\u064e \u0644\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0630\u064e\u0644\u064f\u0648\u0644\u0657\u0627 \u0641\u064e\u0671\u0645\u06e1\u0634\u064f\u0648\u0627\u0652 \u0641\u0650\u064a \u0645\u064e\u0646\u064e\u0627\u0643\u0650\u0628\u0650\u0647\u064e\u0627 \u0648\u064e\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0645\u0650\u0646 \u0631\u0651\u0650\u0632\u06e1\u0642\u0650\u0647\u0650\u06e6\u06d6 \u0648\u064e\u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650 \u0671\u0644\u0646\u0651\u064f\u0634\u064f\u0648\u0631\u064f","translation":"\u0b85\u0bb5\u0ba9\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd \u0baa\u0bc2\u0bae\u0bbf\u0baf\u0bc8 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 (\u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0b9a\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b85\u0ba4\u0ba9\u0bc8 \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd) \u0b87\u0bb2\u0b95\u0bc1\u0bb5\u0bbe\u0b95 \u0b86\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bbe\u0ba9\u0bcd. \u0b86\u0b95\u0bb5\u0bc7, (\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbe\u0bb4\u0bcd\u0bb5\u0bbe\u0ba4\u0bbe\u0bb0\u0ba4\u0bcd\u0ba4\u0bc8\u0ba4\u0bcd \u0ba4\u0bc7\u0b9f\u0bbf) \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0ba4\u0ba9\u0bcd \u0baa\u0bb2 \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b9a\u0bc6\u0bb2\u0bcd\u0bb2\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd! \u0b85\u0bb5\u0ba9\u0bcd \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bbf\u0baf \u0b89\u0ba3\u0bb5\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0b89\u0ba3\u0bcd\u0ba3\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd! \u0b85\u0bb5\u0ba9\u0bcd \u0baa\u0b95\u0bcd\u0b95\u0bae\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd (\u0bae\u0bb1\u0bc1\u0bae\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd) \u0b8e\u0bb4\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bb5\u0ba4\u0bc1 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.","footnotes":""},{"id":"5257","sura":"67","aya":"16","arabic_text":"\u0621\u064e\u0623\u064e\u0645\u0650\u0646\u062a\u064f\u0645 \u0645\u0651\u064e\u0646 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u0650 \u0623\u064e\u0646 \u064a\u064e\u062e\u06e1\u0633\u0650\u0641\u064e \u0628\u0650\u0643\u064f\u0645\u064f \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0647\u0650\u064a\u064e \u062a\u064e\u0645\u064f\u0648\u0631\u064f","translation":"\u0bb5\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bae\u0bc7\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bb5\u0ba9\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0baa\u0bc2\u0bae\u0bbf\u0baf\u0bbf\u0bb2\u0bcd \u0b9a\u0bca\u0bb0\u0bc1\u0b95\u0bbf\u0bb5\u0bbf\u0b9f\u0bc1\u0bb5\u0ba4\u0bc8 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0baf\u0bae\u0bb1\u0bcd\u0bb1\u0bc1 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bbe? \u0b85\u0baa\u0bcd\u0baa\u0bcb\u0ba4\u0bc1 \u0b85\u0ba4\u0bc1 (-\u0baa\u0bc2\u0bae\u0bbf) \u0b95\u0bc1\u0bb2\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bae\u0bcd. (\u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bb4\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1\u0bb5\u0bbf\u0b9f\u0bc1\u0bb5\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcd.)","footnotes":""},{"id":"5258","sura":"67","aya":"17","arabic_text":"\u0623\u064e\u0645\u06e1 \u0623\u064e\u0645\u0650\u0646\u062a\u064f\u0645 \u0645\u0651\u064e\u0646 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u0650 \u0623\u064e\u0646 \u064a\u064f\u0631\u06e1\u0633\u0650\u0644\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u06e1 \u062d\u064e\u0627\u0635\u0650\u0628\u0657\u0627\u06d6 \u0641\u064e\u0633\u064e\u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0643\u064e\u064a\u06e1\u0641\u064e \u0646\u064e\u0630\u0650\u064a\u0631\u0650","translation":"\u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1, \u0bb5\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bae\u0bc7\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0bb5\u0ba9\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc0\u0ba4\u0bc1 \u0b95\u0bb2\u0bcd \u0bae\u0bb4\u0bc8\u0baf\u0bc8 \u0b85\u0ba9\u0bc1\u0baa\u0bcd\u0baa\u0bc1\u0bb5\u0ba4\u0bc8 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0baf\u0bae\u0bb1\u0bcd\u0bb1\u0bc1 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bbe? (\u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0ba4\u0bc1 \u0ba4\u0ba3\u0bcd\u0b9f\u0ba9\u0bc8\u0baf\u0bc8 \u0b95\u0ba3\u0bcd\u0b95\u0bc2\u0b9f\u0bbe\u0b95 \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0baa\u0bcb\u0ba4\u0bc1) \u0b8e\u0ba9\u0bcd \u0b8e\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8 \u0b8e\u0baa\u0bcd\u0baa\u0b9f\u0bbf \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0ba4\u0bc1 \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc8 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbf\u0bb0\u0bc8\u0bb5\u0bbf\u0bb2\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcd!","footnotes":""},{"id":"5259","sura":"67","aya":"18","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0645\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u0650\u0647\u0650\u0645\u06e1 \u0641\u064e\u0643\u064e\u064a\u06e1\u0641\u064e \u0643\u064e\u0627\u0646\u064e \u0646\u064e\u0643\u0650\u064a\u0631\u0650","translation":"\u0b87\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bb0\u0bcd \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0bae\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bb5\u0b9f\u0bcd\u0b9f\u0bae\u0bbe\u0b95 \u0baa\u0bca\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bbf\u0ba4\u0bcd\u0ba4\u0ba9\u0bb0\u0bcd. \u0b86\u0b95, \u0b8e\u0ba9\u0ba4\u0bc1 \u0bae\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc1(\u0bae\u0bcd \u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0bae\u0bc1\u0bae\u0bcd) \u0b8e\u0baa\u0bcd\u0baa\u0b9f\u0bbf \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0ba4\u0bc1? (\u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b9a\u0bbf\u0ba8\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0baa\u0bbe\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd!)","footnotes":""},{"id":"5260","sura":"67","aya":"19","arabic_text":"\u0623\u064e\u0648\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u0631\u064e\u0648\u06e1\u0627\u0652 \u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0637\u0651\u064e\u064a\u06e1\u0631\u0650 \u0641\u064e\u0648\u06e1\u0642\u064e\u0647\u064f\u0645\u06e1 \u0635\u064e\u0670\u0653\u0641\u0651\u064e\u0670\u062a\u0656 \u0648\u064e\u064a\u064e\u0642\u06e1\u0628\u0650\u0636\u06e1\u0646\u064e\u06da \u0645\u064e\u0627 \u064a\u064f\u0645\u06e1\u0633\u0650\u0643\u064f\u0647\u064f\u0646\u0651\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u064f\u06da \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0628\u0650\u0643\u064f\u0644\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u0650\u06ed \u0628\u064e\u0635\u0650\u064a\u0631\u064c","translation":"\u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc7\u0bb2\u0bcd \u0baa\u0bb1\u0bb5\u0bc8\u0b95\u0bb3\u0bcd (\u0b87\u0bb1\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bc8) \u0bb5\u0bbf\u0bb0\u0bbf\u0ba4\u0bcd\u0ba4\u0bb5\u0bc8\u0b95\u0bb3\u0bbe\u0b95\u0bb5\u0bc1\u0bae\u0bcd (\u0b9a\u0bbf\u0bb2 \u0ba8\u0bc7\u0bb0\u0bae\u0bcd \u0b85\u0bb5\u0bb1\u0bcd\u0bb1\u0bc8 \u0ba4\u0bae\u0bcd \u0bb5\u0bbf\u0bb2\u0bbe\u0b95\u0bcd\u0b95\u0bb3\u0bc1\u0b9f\u0ba9\u0bcd) \u0bae\u0b9f\u0b95\u0bcd\u0b95\u0bbf\u0baf\u0bb5\u0bc8\u0b95\u0bb3\u0bbe\u0b95\u0bb5\u0bc1\u0bae\u0bcd \u0baa\u0bb1\u0baa\u0bcd\u0baa\u0ba4\u0bc8 \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bb5\u0bbf\u0bb2\u0bcd\u0bb2\u0bc8\u0baf\u0bbe? (\u0b85\u0bb5\u0bc8 \u0b95\u0bc0\u0bb4\u0bc7 \u0bb5\u0bbf\u0bb4\u0bbe\u0bae\u0bb2\u0bcd \u0b86\u0b95\u0bbe\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baf\u0bbe\u0bb0\u0bc1\u0bae\u0bcd) \u0b85\u0bb5\u0bb1\u0bcd\u0bb1\u0bc8 \u0ba8\u0bbf\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bb5\u0bbf\u0bb2\u0bcd\u0bb2\u0bc8, \u0bb0\u0bb9\u0bcd\u0bae\u0bbe\u0ba9\u0bc8\u0ba4\u0bcd \u0ba4\u0bb5\u0bbf\u0bb0. \u0ba8\u0bbf\u0b9a\u0bcd\u0b9a\u0baf\u0bae\u0bbe\u0b95 \u0b85\u0bb5\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe\u0baa\u0bcd \u0baa\u0bca\u0bb0\u0bc1\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b89\u0bb1\u0bcd\u0bb1\u0bc1 \u0ba8\u0bcb\u0b95\u0bcd\u0b95\u0bc1\u0baa\u0bb5\u0ba9\u0bcd \u0b86\u0bb5\u0bbe\u0ba9\u0bcd.","footnotes":""},{"id":"5261","sura":"67","aya":"20","arabic_text":"\u0623\u064e\u0645\u0651\u064e\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0647\u064f\u0648\u064e \u062c\u064f\u0646\u062f\u065e \u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u064a\u064e\u0646\u0635\u064f\u0631\u064f\u0643\u064f\u0645 \u0645\u0651\u0650\u0646 \u062f\u064f\u0648\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u0650\u06da \u0625\u0650\u0646\u0650 \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u0650\u064a \u063a\u064f\u0631\u064f\u0648\u0631\u064d","translation":"\u0bae\u0bbe\u0bb1\u0bbe\u0b95, \u0bb0\u0bb9\u0bcd\u0bae\u0bbe\u0ba9\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0bbe\u0bae\u0bb2\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0ba4\u0bb5\u0bc1\u0b95\u0bbf\u0bb1 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb0\u0bbe\u0ba3\u0bc1\u0bb5\u0bae\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1 \u0b87\u0bb5\u0bb0\u0bcd \u0baf\u0bbe\u0bb0\u0bcd? (\u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0bbe\u0bb9\u0bcd\u0bb5\u0bc8 \u0b85\u0ba9\u0bcd\u0bb1\u0bbf \u0ba4\u0bc6\u0baf\u0bcd\u0bb5\u0bae\u0bbe\u0b95 \u0baf\u0bbe\u0bb0\u0bc8 \u0ba8\u0bae\u0bcd\u0baa\u0bbf \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcb \u0b85\u0ba4\u0bc1 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0ba4\u0bb5 \u0bae\u0bc1\u0ba9\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bbe?) \u0ba8\u0bbf\u0bb0\u0bbe\u0b95\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bcd (\u0baa\u0bc6\u0bb0\u0bc1\u0bae\u0bcd) \u0b8f\u0bae\u0bbe\u0bb1\u0bcd\u0bb1\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0ba4\u0bb5\u0bbf\u0bb0 \u0b87\u0bb2\u0bcd\u0bb2\u0bc8.","footnotes":""},{"id":"5262","sura":"67","aya":"21","arabic_text":"\u0623\u064e\u0645\u0651\u064e\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064e\u0631\u06e1\u0632\u064f\u0642\u064f\u0643\u064f\u0645\u06e1 \u0625\u0650\u0646\u06e1 \u0623\u064e\u0645\u06e1\u0633\u064e\u0643\u064e \u0631\u0650\u0632\u06e1\u0642\u064e\u0647\u064f\u06e5\u06da \u0628\u064e\u0644 \u0644\u0651\u064e\u062c\u0651\u064f\u0648\u0627\u0652 \u0641\u0650\u064a \u0639\u064f\u062a\u064f\u0648\u0651\u0656 \u0648\u064e\u0646\u064f\u0641\u064f\u0648\u0631\u064d","translation":"\u0bae\u0bbe\u0bb1\u0bbe\u0b95, \u0b85\u0bb5\u0ba9\u0bcd (-\u0b85\u0bb2\u0bcd\u0bb2\u0bbe\u0bb9\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bbf \u0bb5\u0ba8\u0bcd\u0ba4) \u0ba4\u0ba9\u0ba4\u0bc1 \u0b89\u0ba3\u0bb5\u0bc8 (\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd) \u0ba4\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1 \u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bbe\u0bb2\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0ba3\u0bb5\u0bb3\u0bbf\u0b95\u0bcd\u0b95\u0bbf\u0bb1 \u0b87\u0bb5\u0bb0\u0bcd \u0baf\u0bbe\u0bb0\u0bcd? (\u0b85\u0bb2\u0bcd\u0bb2\u0bbe\u0bb9\u0bcd\u0bb5\u0bc8 \u0b85\u0ba9\u0bcd\u0bb1\u0bbf \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b89\u0ba3\u0bb5\u0bb3\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bb1\u0bcd\u0b95\u0bc1 \u0baf\u0bbe\u0bb0\u0bc1\u0bae\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bbe?) \u0bae\u0bbe\u0bb1\u0bbe\u0b95, \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd (\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0bca\u0ba8\u0bcd\u0ba4\u0bb0\u0bb5\u0bc1 \u0ba4\u0bb0\u0bc1\u0bb5\u0ba4\u0bbf\u0bb2\u0bcd) \u0b8e\u0bb2\u0bcd\u0bb2\u0bc8 \u0bae\u0bc0\u0bb1\u0bc1\u0bb5\u0ba4\u0bbf\u0bb2\u0bc1\u0bae\u0bcd (\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0ba4\u0bcd\u0ba4\u0bc8 \u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1) \u0bb5\u0bbf\u0bb2\u0b95\u0bbf \u0b9a\u0bc6\u0bb2\u0bcd\u0bb5\u0ba4\u0bbf\u0bb2\u0bc1\u0bae\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd \u0baa\u0bbf\u0b9f\u0bbf\u0bb5\u0bbe\u0ba4\u0bae\u0bcd \u0baa\u0bbf\u0b9f\u0bbf\u0ba4\u0bcd\u0ba4\u0ba9\u0bb0\u0bcd.","footnotes":""},{"id":"5263","sura":"67","aya":"22","arabic_text":"\u0623\u064e\u0641\u064e\u0645\u064e\u0646 \u064a\u064e\u0645\u06e1\u0634\u0650\u064a \u0645\u064f\u0643\u0650\u0628\u0651\u064b\u0627 \u0639\u064e\u0644\u064e\u0649\u0670 \u0648\u064e\u062c\u06e1\u0647\u0650\u0647\u0650\u06e6\u0653 \u0623\u064e\u0647\u06e1\u062f\u064e\u0649\u0670\u0653 \u0623\u064e\u0645\u0651\u064e\u0646 \u064a\u064e\u0645\u06e1\u0634\u0650\u064a \u0633\u064e\u0648\u0650\u064a\u0651\u064b\u0627 \u0639\u064e\u0644\u064e\u0649\u0670 \u0635\u0650\u0631\u064e\u0670\u0637\u0656 \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0642\u0650\u064a\u0645\u0656","translation":"\u0b86\u0b95, \u0ba4\u0ba9\u0ba4\u0bc1 \u0bae\u0bc1\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0bae\u0bc0\u0ba4\u0bc1 \u0b95\u0bb5\u0bbf\u0bb4\u0bcd\u0ba8\u0bcd\u0ba4\u0bb5\u0ba9\u0bbe\u0b95 \u0ba8\u0b9f\u0baa\u0bcd\u0baa\u0bb5\u0ba9\u0bcd \u0ba8\u0bc7\u0bb0\u0bcd\u0bb5\u0bb4\u0bbf \u0baa\u0bc6\u0bb1\u0bcd\u0bb1\u0bb5\u0ba9\u0bbe? (-\u0b85\u0bb5\u0ba9\u0bcd \u0ba4\u0ba9\u0bcd \u0b87\u0bb2\u0b95\u0bcd\u0b95\u0bc8 \u0ba8\u0bcb\u0b95\u0bcd\u0b95\u0bbf \u0b9a\u0bc6\u0bb2\u0bcd\u0bb2 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bc1\u0bae\u0bbe?) \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1, \u0ba8\u0bc7\u0bb0\u0bbe\u0ba9 \u0baa\u0bbe\u0ba4\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b9a\u0bb0\u0bbf\u0baf\u0bbe\u0b95 \u0ba8\u0b9f\u0baa\u0bcd\u0baa\u0bb5\u0ba9\u0bbe?","footnotes":""},{"id":"5264","sura":"67","aya":"23","arabic_text":"\u0642\u064f\u0644\u06e1 \u0647\u064f\u0648\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0653 \u0623\u064e\u0646\u0634\u064e\u0623\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u062c\u064e\u0639\u064e\u0644\u064e \u0644\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u0633\u0651\u064e\u0645\u06e1\u0639\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0641\u06e1\u0640\u0654\u0650\u062f\u064e\u0629\u064e\u06da \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0645\u0651\u064e\u0627 \u062a\u064e\u0634\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e","translation":"(\u0ba8\u0baa\u0bbf\u0baf\u0bc7!) \u0b95\u0bc2\u0bb1\u0bc1\u0bb5\u0bc0\u0bb0\u0bbe\u0b95! \u0b85\u0bb5\u0ba9\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0b89\u0bb0\u0bc1\u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bbe\u0ba9\u0bcd. \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd, \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b9a\u0bc6\u0bb5\u0bbf\u0baf\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0ba9\u0bcd. \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd (\u0b85\u0bb5\u0ba9\u0bc1\u0b95\u0bcd\u0b95\u0bc1) \u0bae\u0bbf\u0b95\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bc8\u0bb5\u0bbe\u0b95\u0bb5\u0bc7 \u0ba8\u0ba9\u0bcd\u0bb1\u0bbf \u0b9a\u0bc6\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0bb1\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcd!","footnotes":""},{"id":"5265","sura":"67","aya":"24","arabic_text":"\u0642\u064f\u0644\u06e1 \u0647\u064f\u0648\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0630\u064e\u0631\u064e\u0623\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650 \u062a\u064f\u062d\u06e1\u0634\u064e\u0631\u064f\u0648\u0646\u064e","translation":"(\u0ba8\u0baa\u0bbf\u0baf\u0bc7!) \u0b95\u0bc2\u0bb1\u0bc1\u0bb5\u0bc0\u0bb0\u0bbe\u0b95! \u0b85\u0bb5\u0ba9\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0baa\u0bc2\u0bae\u0bbf\u0baf\u0bbf\u0bb2\u0bcd (\u0baa\u0bb2 \u0b8a\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd, \u0baa\u0bb2 \u0ba8\u0bbe\u0b9f\u0bc1\u0b95\u0bb3\u0bbf\u0bb2\u0bcd) \u0baa\u0bb0\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bbe\u0ba9\u0bcd. \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd, \u0b85\u0bb5\u0ba9\u0bcd \u0baa\u0b95\u0bcd\u0b95\u0bae\u0bc7 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd (\u0bae\u0bb1\u0bc1\u0bae\u0bc8\u0baf\u0bbf\u0bb2\u0bcd) \u0b92\u0ba9\u0bcd\u0bb1\u0bc1 \u0ba4\u0bbf\u0bb0\u0b9f\u0bcd\u0b9f\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bb5\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcd.","footnotes":""},{"id":"5266","sura":"67","aya":"25","arabic_text":"\u0648\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0645\u064e\u062a\u064e\u0649\u0670 \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u0648\u064e\u0639\u06e1\u062f\u064f \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u0635\u064e\u0670\u062f\u0650\u0642\u0650\u064a\u0646\u064e","translation":"\u201c\u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b89\u0ba3\u0bcd\u0bae\u0bc8\u0baf\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bbe\u0b95 \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bbe\u0bb2\u0bcd (\u0bae\u0bb1\u0bc1\u0bae\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0bbe\u0bb9\u0bcd\u0bb5\u0bbf\u0b9f\u0bae\u0bcd \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0bb4\u0bc1\u0baa\u0bcd\u0baa\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bb5\u0bcb\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1) \u0b87\u0ba8\u0bcd\u0ba4 \u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0baa\u0bcd\u0baa\u0bca\u0bb4\u0bc1\u0ba4\u0bc1 \u0ba8\u0bbf\u0b95\u0bb4\u0bc1\u0bae\u0bcd (\u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd!)\u201d \u0b8e\u0ba9 \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b95\u0bc2\u0bb1\u0bc1\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd.","footnotes":""},{"id":"5267","sura":"67","aya":"26","arabic_text":"\u0642\u064f\u0644\u06e1 \u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627 \u0671\u0644\u06e1\u0639\u0650\u0644\u06e1\u0645\u064f \u0639\u0650\u0646\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u064e\u0627\u06e0 \u0646\u064e\u0630\u0650\u064a\u0631\u065e \u0645\u0651\u064f\u0628\u0650\u064a\u0646\u065e","translation":"(\u0ba8\u0baa\u0bbf\u0baf\u0bc7!) \u0b95\u0bc2\u0bb1\u0bc1\u0bb5\u0bc0\u0bb0\u0bbe\u0b95! (\u0b85\u0ba4\u0bc1 \u0baa\u0bb1\u0bcd\u0bb1\u0bbf\u0baf) \u0b85\u0bb1\u0bbf\u0bb5\u0bc6\u0bb2\u0bcd\u0bb2\u0bbe\u0bae\u0bcd \u0b85\u0bb2\u0bcd\u0bb2\u0bbe\u0bb9\u0bcd\u0bb5\u0bbf\u0b9f\u0bae\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0ba4\u0bc1. \u0ba8\u0bbe\u0ba9\u0bcd \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe\u0bae\u0bcd \u0ba4\u0bc6\u0bb3\u0bbf\u0bb5\u0bbe\u0ba9 \u0b8e\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd.","footnotes":""},{"id":"5268","sura":"67","aya":"27","arabic_text":"\u0641\u064e\u0644\u064e\u0645\u0651\u064e\u0627 \u0631\u064e\u0623\u064e\u0648\u06e1\u0647\u064f \u0632\u064f\u0644\u06e1\u0641\u064e\u0629\u0657 \u0633\u0650\u064a\u0653\u0640\u0654\u064e\u062a\u06e1 \u0648\u064f\u062c\u064f\u0648\u0647\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0648\u064e\u0642\u0650\u064a\u0644\u064e \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0643\u064f\u0646\u062a\u064f\u0645 \u0628\u0650\u0647\u0650\u06e6 \u062a\u064e\u062f\u0651\u064e\u0639\u064f\u0648\u0646\u064e","translation":"\u0b86\u0b95, \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b85(\u0ba8\u0bcd\u0ba4 \u0bae\u0bb1\u0bc1\u0bae\u0bc8 \u0ba8\u0bbf\u0b95\u0bb4\u0bcd\u0bb5)\u0ba4\u0bc8 \u0bae\u0bbf\u0b95 \u0b9a\u0bae\u0bc0\u0baa\u0bae\u0bbe\u0b95 \u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0baa\u0bcb\u0ba4\u0bc1 \u0ba8\u0bbf\u0bb0\u0bbe\u0b95\u0bb0\u0bbf\u0ba4\u0bcd\u0ba4\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0bae\u0bc1\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb4\u0bbf\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd\u0bb3\u0bbe\u0b95\u0bbf \u0bb5\u0bbf\u0b9f\u0bc1\u0bae\u0bcd. \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd, \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba4\u0bc8 \u0ba4\u0bc7\u0b9f\u0bbf \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcb \u0b85(\u0ba8\u0bcd\u0ba4 \u0bae\u0bb1\u0bc1\u0bae\u0bc8 \u0ba8\u0bbe\u0bb3\u0bbe\u0ba9)\u0ba4\u0bc1 \u0b87\u0ba4\u0bc1\u0ba4\u0bbe\u0ba9\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b95\u0bc2\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd.","footnotes":""},{"id":"5269","sura":"67","aya":"28","arabic_text":"\u0642\u064f\u0644\u06e1 \u0623\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u06e1 \u0625\u0650\u0646\u06e1 \u0623\u064e\u0647\u06e1\u0644\u064e\u0643\u064e\u0646\u0650\u064a\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0648\u064e\u0645\u064e\u0646 \u0645\u0651\u064e\u0639\u0650\u064a\u064e \u0623\u064e\u0648\u06e1 \u0631\u064e\u062d\u0650\u0645\u064e\u0646\u064e\u0627 \u0641\u064e\u0645\u064e\u0646 \u064a\u064f\u062c\u0650\u064a\u0631\u064f \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e \u0645\u0650\u0646\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u064d \u0623\u064e\u0644\u0650\u064a\u0645\u0656","translation":"(\u0ba8\u0baa\u0bbf\u0baf\u0bc7!) \u0b95\u0bc2\u0bb1\u0bc1\u0bb5\u0bc0\u0bb0\u0bbe\u0b95! \u201c\u0b85\u0bb2\u0bcd\u0bb2\u0bbe\u0bb9\u0bcd \u0b8e\u0ba9\u0bcd\u0ba9\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0ba9\u0bc1\u0b9f\u0ba9\u0bcd \u0b87\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0bae\u0bb0\u0ba3\u0bbf\u0b95\u0bcd\u0b95 \u0b9a\u0bc6\u0baf\u0bcd\u0ba4\u0bc1 \u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bbe\u0bb2\u0bcd; \u0b85\u0bb2\u0bcd\u0bb2\u0ba4\u0bc1, \u0b85\u0bb5\u0ba9\u0bcd \u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc0\u0ba4\u0bc1 \u0b95\u0bb0\u0bc1\u0ba3\u0bc8 \u0baa\u0bc1\u0bb0\u0bbf\u0ba8\u0bcd(\u0ba4\u0bc1 \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd \u0b9a\u0bbf\u0bb2 \u0b95\u0bbe\u0bb2\u0bae\u0bcd \u0b89\u0baf\u0bbf\u0bb0\u0bcb\u0b9f\u0bc1 \u0bb5\u0bbe\u0bb4\u0bb5\u0bc8\u0ba4\u0bcd)\u0ba4\u0bbe\u0bb2\u0bcd, (\u0b85\u0ba4\u0bc1 \u0b85\u0bb5\u0ba9\u0ba4\u0bc1 \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0baa\u0b9f\u0bbf \u0b85\u0bb5\u0ba9\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0bb5\u0ba4\u0bbe\u0b95\u0bc1\u0bae\u0bcd.) \u0b86\u0b95, \u0ba4\u0bc1\u0ba9\u0bcd\u0baa\u0bc1\u0bb1\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd \u0ba4\u0ba3\u0bcd\u0b9f\u0ba9\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0ba8\u0bbf\u0bb0\u0bbe\u0b95\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0bb3\u0bb0\u0bcd\u0b95\u0bb3\u0bc8 \u0baf\u0bbe\u0bb0\u0bcd \u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bbe\u0bb1\u0bcd\u0bb1\u0bc1\u0bb5\u0bbe\u0bb0\u0bcd? (\u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbe\u0bb4\u0bcd\u0bb5\u0ba4\u0bc1\u0bae\u0bcd \u0bae\u0bb0\u0ba3\u0bbf\u0baa\u0bcd\u0baa\u0ba4\u0bc1\u0bae\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0b85\u0bb2\u0bcd\u0bb2\u0bbe\u0bb9\u0bcd\u0bb5\u0bbf\u0ba9\u0bcd \u0ba8\u0bb0\u0b95 \u0ba4\u0ba3\u0bcd\u0b9f\u0ba9\u0bc8\u0baf\u0bbf\u0bb2\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1 \u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bbe\u0bb1\u0bcd\u0bb1\u0bbf\u0bb5\u0bbf\u0b9f\u0bc1\u0bae\u0bbe?)\u201d \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.","footnotes":""},{"id":"5270","sura":"67","aya":"29","arabic_text":"\u0642\u064f\u0644\u06e1 \u0647\u064f\u0648\u064e \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u064f \u0621\u064e\u0627\u0645\u064e\u0646\u0651\u064e\u0627 \u0628\u0650\u0647\u0650\u06e6 \u0648\u064e\u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u062a\u064e\u0648\u064e\u0643\u0651\u064e\u0644\u06e1\u0646\u064e\u0627\u06d6 \u0641\u064e\u0633\u064e\u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e \u0645\u064e\u0646\u06e1 \u0647\u064f\u0648\u064e \u0641\u0650\u064a \u0636\u064e\u0644\u064e\u0670\u0644\u0656 \u0645\u0651\u064f\u0628\u0650\u064a\u0646\u0656","translation":"(\u0ba8\u0baa\u0bbf\u0baf\u0bc7!) \u0b95\u0bc2\u0bb1\u0bc1\u0bb5\u0bc0\u0bb0\u0bbe\u0b95! \u201c\u0b85\u0bb5\u0ba9\u0bcd\u0ba4\u0bbe\u0ba9\u0bcd \u0bb0\u0bb9\u0bcd\u0bae\u0bbe\u0ba9\u0bcd (-\u0b85\u0bb3\u0bb5\u0bb1\u0bcd\u0bb1 \u0b85\u0bb0\u0bc1\u0bb3\u0bbe\u0bb3\u0ba9\u0bcd, \u0bae\u0b95\u0bbe \u0b95\u0bb0\u0bc1\u0ba3\u0bc8\u0baf\u0bbe\u0bb3\u0ba9\u0bcd). \u0b85\u0bb5\u0ba9\u0bc8 \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8 \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bcb\u0bae\u0bcd. \u0b87\u0ba9\u0bcd\u0ba9\u0bc1\u0bae\u0bcd, \u0b85\u0bb5\u0ba9\u0bcd \u0bae\u0bc0\u0ba4\u0bc7 \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8 \u0bb5\u0bc8\u0ba4\u0bcd\u0ba4\u0bcb\u0bae\u0bcd. \u0b86\u0b95, \u0ba4\u0bc6\u0bb3\u0bbf\u0bb5\u0bbe\u0ba9 \u0bb5\u0bb4\u0bbf\u0b95\u0bc7\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0baf\u0bbe\u0bb0\u0bcd \u0b87\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc8 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbf\u0bb0\u0bc8\u0bb5\u0bbf\u0bb2\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcd.","footnotes":""},{"id":"5271","sura":"67","aya":"30","arabic_text":"\u0642\u064f\u0644\u06e1 \u0623\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u06e1 \u0625\u0650\u0646\u06e1 \u0623\u064e\u0635\u06e1\u0628\u064e\u062d\u064e \u0645\u064e\u0627\u0653\u0624\u064f\u0643\u064f\u0645\u06e1 \u063a\u064e\u0648\u06e1\u0631\u0657\u0627 \u0641\u064e\u0645\u064e\u0646 \u064a\u064e\u0623\u06e1\u062a\u0650\u064a\u0643\u064f\u0645 \u0628\u0650\u0645\u064e\u0627\u0653\u0621\u0656 \u0645\u0651\u064e\u0639\u0650\u064a\u0646\u0650\u06ed","translation":"(\u0ba8\u0baa\u0bbf\u0baf\u0bc7!) \u0b95\u0bc2\u0bb1\u0bc1\u0bb5\u0bc0\u0bb0\u0bbe\u0b95! \u201c\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0ba3\u0bcd\u0ba3\u0bc0\u0bb0\u0bcd (\u0b85\u0ba4\u0bc8 \u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0b9f\u0bc1\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4 \u0b85\u0bb3\u0bb5\u0bbf\u0bb1\u0bcd\u0b95\u0bc1) \u0b86\u0bb4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b9a\u0bc6\u0ba9\u0bcd\u0bb1\u0bc1\u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bbe\u0bb2\u0bcd \u0baf\u0bbe\u0bb0\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0ba4\u0bc1\u0bb0\u0bae\u0bbe\u0ba9 \u0ba4\u0ba3\u0bcd\u0ba3\u0bc0\u0bb0\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bc1 \u0bb5\u0bb0\u0bc1\u0bb5\u0bbe\u0bb0\u0bcd? \u0b8e\u0ba9\u0bcd\u0baa\u0ba4\u0bc8 (\u0b8e\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1) \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.\u201d","footnotes":""}]}